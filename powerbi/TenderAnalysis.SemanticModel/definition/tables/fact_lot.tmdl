table fact_lot
	lineageTag: 4dabd58d-6b5f-4ad0-8528-91878a7d201a

	measure Lots = COUNTROWS(fact_lot)
		formatString: #,0
		lineageTag: c3f2bbf6-7144-4750-8740-04d5eae44b22

	measure 'Total Value' = SUM(fact_lot[value_pln])
		formatString: #,0
		lineageTag: 46903010-2849-4820-b45e-a5f432bb0841

	measure 'Total Value (bln PLN)' = DIVIDE([Total Value], 1e9)
		formatString: #,0.0
		lineageTag: b8faf7e1-fb1e-4e96-9c24-e48a56e30297

	measure 'Lots With Offers' = CALCULATE(COUNTROWS(fact_lot), NOT ISBLANK(fact_lot[n_offers]))
		formatString: #,0
		lineageTag: 90379bd2-d6c8-4420-bf65-3b23d1d90b5a

	measure 'Single Offer Lots' = CALCULATE(COUNTROWS(fact_lot), fact_lot[single_offer] = TRUE())
		formatString: #,0
		lineageTag: ef21efcd-b5d3-412d-9fa2-09fd8fe718c7

	measure 'Single Offer %' = DIVIDE([Single Offer Lots], [Lots With Offers])
		formatString: 0.0%
		lineageTag: 7585b65e-cde5-4edd-97ba-dcd424ef2fb8

	measure 'Avg Offers' = AVERAGE(fact_lot[n_offers])
		formatString: 0.00
		lineageTag: 527e7421-5b7f-4811-b100-edc6f4861ef2

	measure 'Median Price to Estimate' = MEDIAN(fact_lot[price_to_estimate])
		formatString: 0.00
		lineageTag: 82b2c803-3bb1-4498-8cd1-712e3830585b

	measure Buyers = DISTINCTCOUNT(fact_lot[buyer_key])
		formatString: #,0
		lineageTag: be008f99-af33-4221-8b90-9c1240b007bf

	measure Winners = DISTINCTCOUNT(fact_lot[winner_key])
		formatString: #,0
		lineageTag: df04ddac-2e12-45aa-925d-ccd1836f6c9a

	measure 'Single Offer Value' = CALCULATE([Total Value], fact_lot[single_offer] = TRUE())
		formatString: #,0
		lineageTag: 4835c2a5-1754-48b9-9985-f0927a4be2a5

	measure 'Top Winner Share' =
			VAR total = [Total Value]
			VAR top_winner = MAXX(VALUES(fact_lot[winner_key]), CALCULATE(SUM(fact_lot[value_pln])))
			RETURN DIVIDE(top_winner, total)
		formatString: 0.0%
		lineageTag: 116a4698-bb41-4c24-8792-bf2484ea9fd1

	measure 'Value Previous Year' = CALCULATE([Total Value], SAMEPERIODLASTYEAR(dim_date[date]))
		formatString: #,0
		lineageTag: f548c93a-48dd-42ba-9bee-903ece442243

	column lot_key
		dataType: string
		lineageTag: 92b1d588-eb60-491e-8475-513a94bb1c3c
		summarizeBy: none
		sourceColumn: lot_key

		annotation SummarizationSetBy = Automatic

	column publication_number
