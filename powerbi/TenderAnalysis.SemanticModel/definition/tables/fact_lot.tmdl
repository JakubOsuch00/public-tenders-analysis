	partition fact_lot = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_lot.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"lot_key", type text}, {"publication_number", type text}, {"publication_date", type date}, {"buyer_key", type text}, {"winner_key", type text}, {"cpv_division", type text}, {"cpv_group", type text}, {"nuts2", type text}, {"contract_nature", type text}, {"procedure_type", type text}, {"framework", type logical}, {"n_offers", Int64.Type}, {"offers_capped", Int64.Type}, {"single_offer", type logical}, {"value_pln", type number}, {"estimated_pln", type number}, {"price_to_estimate", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

